{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/zh",
      "destination": "/zh.html"
    },
    {
      "source": "/app/:path((?!assets/).*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/furniture",
      "destination": "/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/index.html"
    },
    {
      "source": "/customers",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/backers",
      "destination": "/index.html"
    },
    {
      "source": "/sample-plan",
      "destination": "/index.html"
    },
    {
      "source": "/help/:path+",
      "destination": "/help/index.html"
    },
    {
      "source": "/trust",
      "destination": "/trust.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "placetta.vercel.app"
        }
      ],
      "destination": "https://www.placetta.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "placetta.vercel.app"
        }
      ],
      "destination": "https://www.placetta.com/$1",
      "permanent": true
    },
    {
      "source": "/zh/",
      "destination": "/zh",
      "permanent": true
    },
    {
      "source": "/zh.html",
      "destination": "/zh",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/guides/forms/sj-btc.html",
      "destination": "/guides/forms/sj-business-tax.html",
      "permanent": true
    },
    {
      "source": "/guides/zh/forms/sj-btc.html",
      "destination": "/guides/zh/forms/sj-business-tax.html",
      "permanent": true
    },
    {
      "source": "/guides/forms/sf-reg.html",
      "destination": "/guides/forms/sf-business-registration.html",
      "permanent": true
    },
    {
      "source": "/guides/zh/forms/sf-reg.html",
      "destination": "/guides/zh/forms/sf-business-registration.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' https://esquxzcfsylffuijvzec.supabase.co wss://esquxzcfsylffuijvzec.supabase.co; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/((?!app/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://esquxzcfsylffuijvzec.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/js/inline/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
