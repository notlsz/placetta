# Odelia's messaging: the names the edge functions read (odelia-sms, odelia-mail, agent-run, monitor). Put the values
# in Supabase, Edge Functions, Secrets, never in the code. `npm run check:messaging -- --env-file=<a copy with values>`
# says which channels are ready. Steps: SETUP.md, "Messaging: what the founder sets up".

# iMessage (Linq)
LINQ_ENABLED=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_NUMBERS=
LINQ_FORWARDS_CALLS=

# SMS (Telnyx), after the 10DLC campaign is approved
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
ODELIA_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=odelia_update
WHATSAPP_NUMBER=

# Email (Amazon SES out, SNS in)
ODELIA_EMAIL=odelia@in.placetta.com
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
AWS_SES_SNS_TOPIC_ARNS=

# Approving a filing by text: the largest agency fee approved by text when Autopilot is off (default 250)
ODELIA_TEXT_APPROVE_MAX=
