 "blank": {
  "phone2": "^(none|no|n/?a)\\.?$"
 },
 "boxes": {
  "business_name": [
   {
    "text": "BUSINESS NAME"
   }
  ],
  "start_date": [
   {
    "text": "STARTING DATE",
    "pick": "date"
   }
  ],
  "phone": [
   {
    "text": "PHONE"
   }
  ],
  "phone2": [
   {
    "text": "SECONDARY PHONE",
    "if": "^(?!(none|no|n/?a|not applicable|无|没有|否|-+)\\.?$)"
   }
  ],
  "email": [
   {
    "text": "EMAIL"
   }
  ],
  "business_address": [
   {
    "text": "BUSNIESS ADDRESS"
   }
  ],
  "home_address": [
   {
    "radio": "IS THIS A HOME ADDRESS",
    "value": "Yes",
    "if": "^(y|yes|是)\\b"
   },
   {
    "radio": "IS THIS A HOME ADDRESS",
    "value": "No_2",
    "if": "^(n|no|否)\\b"
   }
  ],
  "employees": [
   {
    "text": "NO OF EMPLOYEES",
    "pick": "digits"
   }
  ],
  "ownership": [
   {
    "check": "Sole",
    "if": "^sole"
   },
   {
    "check": "Corporation",
    "if": "^corp"
   },
   {
    "check": "Partnership",
    "if": "^partner"
   },
   {
    "check": "LLC",
    "if": "^(llc|limited liability)"
   }
  ],
  "description": [
   {
    "text": "BUSINESS DESCRIPTION"
   }
  ],
  "classification": [
   {
    "check": "Gross Receipts",
    "if": "^gross receipts|^commercial"
   },
   {
    "text": "Estimated Gross ReceiptsRent",
    "pick": "tail|digits",
    "if": "^gross receipts|^commercial"
   },
   {
    "check": "Gross Payroll",
    "if": "^gross payroll"
   },
   {
    "text": "Estimated Gross Payroll",
    "pick": "tail|digits",
    "if": "^gross payroll"
   },
   {
    "check": "undefined",
    "if": "^professional"
   },
   {
    "text": "Years Licensed",
    "pick": "tail|digits",
    "if": "^professional"
   },
   {
    "check": "Residential Rental",
    "if": "^residential"
   },
   {
    "text": "Number of Rental Units",
    "pick": "tail|digits",
    "if": "^residential"
   }
  ],
  "mailing": [
   {
    "text": "CORPORATEMAILING ADDRESS"
   }
  ],
  "owners": [
   {
    "text": "OWNER OR CORPORATE OFFICER NAME",
    "pick": "line1|head"
   },
   {
    "text": "RELATIONSHIP TO THE COMPANY",
    "pick": "line1|tail"
   },
   {
    "text": "OWNER OR CORPORATE OFFICER NAME_2",
    "pick": "line2|head"
   },
   {
    "text": "RELATIONSHIP TO THE COMPANY_2",
    "pick": "line2|tail"
   },
   {
    "text": "OWNER OR CORPORATE OFFICER NAME_3",
    "pick": "line3|head"
   },
   {
    "text": "RELATIONSHIP TO THE COMPANY_3",
    "pick": "line3|tail"
   }
  ]
 }
