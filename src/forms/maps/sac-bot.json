 "unmapped": {
  "gov_id": "This one box takes either an EIN or a Social Security number, and Placetta never writes a number into a box meant for an SSN; the applicant writes the EIN there by hand.",
  "owner_ssn": "Placetta never writes Social Security numbers; each owner writes theirs by hand.",
