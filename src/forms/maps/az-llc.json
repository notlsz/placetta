    "value": "14",
    "if": "^(limited liability company|llc|l\\.?l\\.?c\\.?)$"
   },
   {
    "radio": "FormRoot[0].Page1[0].General[0].EntitySubtype[0]",
    "value": "15",
    "if": "^(professional|pllc|plc)"
   }
  ],
  "name": [
   {
    "text": "FormRoot[0].Page1[0].General[0].NameOfEntity[0]"
   }
  ],
