 "boxes": {
  "purpose": [
   {
    "check": "Check Box - New",
    "if": "^new"
   },
   {
    "check": "Check Box - Change of Owner",
    "if": "^change of owner"
   },
   {
    "check": "Check Box - Name Change",
    "if": "^name"
   },
   {
    "check": "Check Box - Renewal",
    "if": "^renewal"
   }
  ],
  "mail_to": [
   {
    "check": "Check Box - Facility",
    "if": "^facility"
   },
   {
    "check": "Check Box - Owner",
    "if": "^owner"
   }
  ],
  "seats": [
   {
    "text": "Number of seats or square footage (if no seats)"
   }
  ],
  "catering": [
   {
    "check": "Check Box - Yes",
    "if": "^(y|yes|是)"
   },
   {
    "check": "Check Box - No",
    "if": "^(n|no|否)"
   }
  ],
  "facility_name": [
   {
    "text": "Name of Facility"
   }
  ],
  "facility_address": [
   {
    "text": "Facility Street Number",
    "pick": "street|streetno"
   },
   {
    "text": "Facility Street Name",
    "pick": "street|streetname"
   },
   {
    "text": "Facilty City",
    "pick": "city"
   },
   {
    "text": "Facility State",
    "pick": "state"
   },
   {
    "text": "Facility Zip Code",
    "pick": "zip"
   }
  ],
  "facility_suite": [
   {
    "text": "Facility Suite Number",
    "if": "^(?!none$)"
   }
  ],
  "former_name": [
   {
    "text": "Former Name of Facility (if applicable)",
    "if": "^(?!none$)"
   }
  ],
  "owner_name": [
   {
    "text": "Name of Owner"
   }
  ],
  "phone": [
   {
    "text": "Telephone Number"
   }
  ],
  "fein": [
   {
    "text": "Federal Tax ID Number",
    "pick": "ein"
   }
  ],
  "email": [
   {
    "text": "Email Address"
   }
  ],
  "hours": [
   {
    "text": "From",
    "pick": "line1",
    "if": "^(?!varies$)"
   },
   {
    "text": "To",
    "pick": "line2",
    "if": "^(?!varies$)"
   }
  ],
  "corp_name": [
   {
    "text": "Owner/Corporation Name"
   }
  ],
  "corp_address": [
   {
    "text": "Owner/Corporation Street Number",
    "pick": "street|streetno"
   },
   {
    "text": "Owner/Corporation Street Name",
    "pick": "street|streetname"
   },
   {
    "text": "Owner/Corporation City",
    "pick": "city"
   },
   {
    "text": "Owner/Corporation State",
    "pick": "state"
   },
   {
    "text": "Owner/Corporation Zip Code",
    "pick": "zip"
   }
  ],
  "corp_suite": [
   {
    "text": "Owner/Corporation Suite Number",
    "if": "^(?!none$)"
   }
  ],
  "water": [
   {
    "check": "Check Box - Public",
    "if": "^public"
   },
   {
    "check": "Check Box - WSSC",
    "if": "wssc"
   },
   {
    "check": "Check Box - City of Rockville",
    "if": "rockville"
   },
   {
    "check": "Check Box -Poolesville",
    "if": "poolesville"
   },
   {
    "check": "Check Box - On-Site/Well",
    "if": "well"
   }
  ],
  "sewage": [
   {
    "check": "Check Box - On-Site/Septic System",
    "if": "septic"
   }
  ],
  "comp_insurer": [
   {
    "text": "Company Name",
    "if": "^(?!none$)"
   }
  ],
  "comp_policy": [
   {
    "text": "Policy/Binder Number",
    "if": "^(?!none$)"
   }
  ],
  "sole_proprietor": [
   {
    "check": "Check Box - Check her if Sole Proprietor",
    "if": "^(y|yes|是)"
   }
  ],
  "emergency_contact": [
   {
    "text": "Emergency Contact Name",
    "pick": "head"
   },
   {
    "text": "Telephoen Number (Not Facility Telepohone Number)",
    "pick": "tail|head"
   },
   {
    "text": "Emergency Contact's Email Address",
    "pick": "tail|tail"
   }
  ],
  "signer": [
   {
    "text": "Printed Name of Applicant",
    "pick": "head"
   },
   {
    "text": "Printed Title of Applicant",
    "pick": "tail"
   }
  ]
 },
 "blank": {
  "facility_suite": "^none$",
  "former_name": "^none$",
  "corp_suite": "^none$",
  "comp_insurer": "^none$",
  "comp_policy": "^none$",
  "hours": "^varies$",
  "sewage": "^public$",
  "sole_proprietor": "^(n|no|否)$"
 }
