 "checked": "2026-10-24",
 "notes": "Georgia's Application for GDOL Tax Account or Status Change, now published as the DOL-1N Employer Status Report (the FAQ still calls it the DOL-1A). Fillable boxes over an XFA layer, which the filler drops. Yes/No answers tick the form's Yes or No box. The EIN and the Georgia DOL account numbers print a digit to a box. Item 1 is the name and mailing address, one per line. Item 4 is the place in Georgia (no P.O. Box); the form prints GA. Item 7 is answered only after an acquisition, merger or change of ownership ('None' leaves its lines blank). Each 'If yes, show date' box takes the date when the answer is Yes. Item C takes up to three 'product or service: percent' lines. The owner's Social Security number is never printed: the signer writes it in its nine boxes by hand, then signs, dates and mails the form to the Georgia Department of Labor. Item B's construction details (general, special trade or heavy construction and their percentages) apply only to construction businesses and are left for the signer.",
 "lines": [
  { "id": "business_name_address", "line": "1", "en": "Business name and mailing address (name on the first line, address on the next)", "zh": "企业名称及邮寄地址（第一行名称，下一行地址）", "hint": { "en": "e.g. \"Lotus Tea House LLC\" then \"5150 Buford Hwy NE, Suite 120, Doraville, GA 30340\".", "zh": "如第一行 \"Lotus Tea House LLC\"，下一行 \"5150 Buford Hwy NE, Suite 120, Doraville, GA 30340\"。" } },
  { "id": "gdol_account", "line": "Account", "en": "Georgia DOL account number, if already assigned", "zh": "佐治亚州劳工部账号（如已分配）", "hint": { "en": "\"None\" for a new employer.", "zh": "新雇主填 \"None\"。" } },
  { "id": "org_type", "line": "2", "en": "Type of organization", "zh": "组织类型", "options": ["Individual", "Partnership", "Corporation", "Nonprofit org.", "Limited Liability CO. (LLC)", "Other (specify)"], "hint": { "en": "For another type, write \"Other: \" and the type.", "zh": "其他类型请写 \"Other: \" 加类型。" } },
  { "id": "trade_name", "line": "3", "en": "Trade name, if different from the business name", "zh": "商号（如与企业名称不同）" },
  { "id": "location", "line": "4", "en": "Principal business location in Georgia: street, city, GA ZIP (no P.O. Box)", "zh": "在佐治亚州的主要营业地点：街道、城市、GA 邮编（不可用邮政信箱）" },
  { "id": "county", "line": "4", "en": "County of that location", "zh": "该地点所在县" },
  { "id": "phone", "line": "4", "en": "Telephone number of that location", "zh": "该地点电话" },
  { "id": "first_employed", "line": "5", "en": "Date first began employing workers in Georgia (MM/DD/YYYY)", "zh": "首次在佐治亚州雇用员工的日期（月/日/年）" },
  { "id": "first_payroll", "line": "5", "en": "Date of first Georgia payroll (MM/DD/YYYY)", "zh": "首次在佐治亚州发薪的日期（月/日/年）" },
  { "id": "futa_liable", "line": "6", "en": "Are you liable for federal unemployment tax (do you file Form 940)?", "zh": "是否须缴纳联邦失业税（是否提交 940 表）？", "options": ["Yes", "No"] },
  { "id": "fein", "line": "6", "en": "Federal employer identification number (EIN)", "zh": "联邦雇主识别号（EIN）" },
  { "id": "acquired", "line": "7", "en": "Have you acquired another business?", "zh": "是否收购了其他企业？", "options": ["Yes", "No"] },
  { "id": "merged", "line": "7", "en": "Have you merged with another business?", "zh": "是否与其他企业合并？", "options": ["Yes", "No"] },
  { "id": "formed", "line": "7", "en": "Have you formed a corporation or partnership?", "zh": "是否成立了公司或合伙企业？", "options": ["Yes", "No"] },
  { "id": "other_change", "line": "7", "en": "Have you made any other change in the ownership of your business?", "zh": "企业所有权是否有其他变更？", "options": ["Yes", "No"] },
  { "id": "other_change_explain", "line": "7", "en": "If yes, explain the change", "zh": "如有，请说明变更", "hint": { "en": "\"None\" when there was no other change.", "zh": "没有其他变更时填 \"None\"。" } },
  { "id": "date_acquired", "line": "7", "en": "Date acquired or changed (MM/DD/YYYY)", "zh": "收购或变更日期（月/日/年）", "hint": { "en": "\"None\" when nothing was acquired or changed.", "zh": "没有收购或变更时填 \"None\"。" } },
  { "id": "predecessor_account", "line": "7", "en": "Predecessor's Georgia DOL account number", "zh": "前任雇主的佐治亚州劳工部账号", "hint": { "en": "\"None\" when there's no predecessor.", "zh": "没有前任雇主时填 \"None\"。" } },
  { "id": "portion", "line": "7", "en": "Did you acquire all, substantially all (90% or more) or part of the Georgia operations?", "zh": "收购的是全部、绝大部分（90% 以上）还是部分佐治亚州业务？", "options": ["None", "All of Georgia operations", "Substantially all of Georgia operations (90% or more)", "Part of Georgia operations (less than 90%)"] },
  { "id": "former_owner_employees", "line": "7", "en": "Does the former owner continue to have employees?", "zh": "原业主是否仍有员工？", "options": ["None", "Yes", "No"] },
  { "id": "predecessor_name", "line": "7", "en": "From whom (organization name, including trade name)", "zh": "从谁处取得（机构名称，含商号）", "hint": { "en": "\"None\" when there's no predecessor.", "zh": "没有前任时填 \"None\"。" } },
  { "id": "predecessor_address", "line": "7", "en": "Address of that organization", "zh": "该机构地址", "hint": { "en": "\"None\" when there's no predecessor.", "zh": "没有前任时填 \"None\"。" } },
  { "id": "twenty_weeks", "line": "8", "en": "Did you, or do you expect to, employ at least one worker in 20 different calendar weeks during a calendar year?", "zh": "一个日历年内是否已经或预计在 20 个不同的日历周雇有至少一名员工？", "options": ["Yes", "No"] },
  { "id": "twenty_weeks_date", "line": "8", "en": "If yes, the date the 20th week first occurred or will occur", "zh": "如是，第 20 周首次出现或将出现的日期", "hint": { "en": "\"None\" when the answer above is No.", "zh": "上题为否时填 \"None\"。" } },
  { "id": "payroll_1500", "line": "8", "en": "Did you, or do you expect to, have a quarterly payroll of $1,500 or more?", "zh": "季度工资是否已经或预计达到 1,500 美元以上？", "options": ["Yes", "No"] },
  { "id": "payroll_1500_date", "line": "8", "en": "If yes, the date this first occurred or will occur", "zh": "如是，首次出现或将出现的日期", "hint": { "en": "\"None\" when the answer above is No.", "zh": "上题为否时填 \"None\"。" } },
  { "id": "domestic", "line": "9", "en": "Domestic employment: did you, or do you expect to, pay cash wages of $1,000 or more in any calendar quarter?", "zh": "家政雇佣：任一季度是否已经或预计支付 1,000 美元以上现金工资？", "options": ["Yes", "No"] },
  { "id": "domestic_date", "line": "9", "en": "If yes, the date this first occurred or will occur", "zh": "如是，首次出现或将出现的日期", "hint": { "en": "\"None\" when the answer above is No.", "zh": "上题为否时填 \"None\"。" } },
  { "id": "ag_workers", "line": "10", "en": "Agricultural employment: did you, or do you expect to, employ 10 or more agricultural workers in 20 different calendar weeks during a calendar year?", "zh": "农业雇佣：一个日历年内是否已经或预计在 20 个不同的日历周雇有 10 名以上农业工人？", "options": ["Yes", "No"] },
  { "id": "ag_workers_date", "line": "10", "en": "If yes, the date the 20th week first occurred or will occur", "zh": "如是，第 20 周首次出现或将出现的日期", "hint": { "en": "\"None\" when the answer above is No.", "zh": "上题为否时填 \"None\"。" } },
  { "id": "ag_payroll", "line": "10", "en": "Did you, or do you expect to, have a gross cash agricultural payroll of $20,000 or more in any calendar quarter?", "zh": "任一季度农业现金工资总额是否已经或预计达到 20,000 美元以上？", "options": ["Yes", "No"] },
  { "id": "ag_payroll_date", "line": "10", "en": "If yes, the date this first occurred or will occur", "zh": "如是，首次出现或将出现的日期", "hint": { "en": "\"None\" when the answer above is No.", "zh": "上题为否时填 \"None\"。" } },
  { "id": "nonprofit_workers", "line": "11", "en": "501(c)(3) nonprofits only: did you, or do you expect to, employ four or more workers in 20 different calendar weeks during a calendar year?", "zh": "仅限 501(c)(3) 非营利组织：一个日历年内是否已经或预计在 20 个不同的日历周雇有 4 名以上员工？", "options": ["None", "Yes", "No"] },
  { "id": "nonprofit_date", "line": "11", "en": "If yes, the date the 20th week first occurred or will occur", "zh": "如是，第 20 周首次出现或将出现的日期", "hint": { "en": "\"None\" when the answer above isn't Yes.", "zh": "上题不是\"是\"时填 \"None\"。" } },
  { "id": "employees", "line": "12", "en": "How many employees do you have (or anticipate when in full operation)?", "zh": "现有（或全面运营时预计的）员工人数" },
  { "id": "owner_name", "line": "Owner", "en": "Name of the owner, a partner or the principal officer", "zh": "业主、合伙人或主要负责人姓名" },
  { "id": "owner_address", "line": "Owner", "en": "That person's residence address: street, city, state ZIP", "zh": "该人的住址：街道、城市、州 邮编" },
  { "id": "owner_phone", "line": "Owner", "en": "That person's telephone number", "zh": "该人电话" },
  { "id": "records_name", "line": "Records", "en": "Name of the person or firm who maintains the financial records of the business", "zh": "保管企业财务记录的个人或公司名称" },
  { "id": "records_address", "line": "Records", "en": "Their address: street, city, state ZIP", "zh": "其地址：街道、城市、州 邮编" },
  { "id": "records_phone", "line": "Records", "en": "Their telephone number", "zh": "其电话" },
  { "id": "signer_title", "line": "Certification", "en": "Title of the owner, partner or principal officer who signs", "zh": "签字人（业主、合伙人或主要负责人）的职务" },
  { "id": "locations", "line": "A", "en": "How many Georgia locations do you operate?", "zh": "在佐治亚州经营几个地点？" },
  { "id": "industry", "line": "B", "en": "The industry that best describes your business activities", "zh": "最能描述您业务活动的行业", "options": ["Agriculture", "Forestry", "Fishing", "Mining", "Construction", "Manufacturing", "Transportation", "Communication", "Public Utilities", "Wholesale Trade", "Retail Trade", "Finance", "Insurance", "Real Estate", "Services", "Public Administration", "Private Household Employer"] },
  { "id": "products", "line": "C", "en": "Principal services or products, in order of importance, each with its approximate % of annual income (one per line)", "zh": "主要服务或产品（按重要性排列，每行一项，附年收入大致占比）", "hint": { "en": "Up to three lines like \"Bubble tea and snacks: 100\".", "zh": "最多三行，如 \"Bubble tea and snacks: 100\"。" } },
  { "id": "product_kind", "line": "C", "en": "Are the principal products manufactured, grown or sold?", "zh": "主要产品是自制、种植还是销售？", "options": ["None", "Mfg.", "Grown", "Sold"] },
  { "id": "support_services", "line": "D", "en": "If an establishment here only serves other units of the company, its primary type of support", "zh": "如本地点只为公司其他单位提供服务，其主要支持类型", "options": ["None", "Central Administration", "Research, development, and testing", "Storage (warehouse)", "Other (specify)"], "hint": { "en": "For another type, write \"Other: \" and the type.", "zh": "其他类型请写 \"Other: \" 加类型。" } }
