642 0 obj<</Subj(Text Box)/Type/Annot/P 5 0 R/F 4/C[]/CreationDate(D:20251202133433-08'00')/T(Ahed Saleh)/Subtype/FreeText/BS<</W 0/S/S/Type/Border>>/DA(1 0 0 rg /Helv 18 Tf)/DS(font: Helvetica 18pt; text-align:center; margin:2.965779pt; line-height:20.70001pt; color:#000000)/M(D:20260105100406-08'00')/AP<</N 644 0 R>>/Rect[2018.626 1246.938 2300.28 1502.569]/NM(BCQVGQNNAXTDURUA)/RC(<?xml version="1.0"?><body xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:contentType="text/html" xfa:APIVersion="BluebeamPDFRevu:2018" xfa:spec="2.2.0" style="font:Helvetica 18pt; text-align:center; margin:2.965779pt; line-height:20.70001pt; color:#000000" xmlns="http://www.w3.org/1999/xhtml"><p style="line-height:20.70001pt; font-size:18pt; color:#000000; font-weight:bold; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center">FACILITY NAME</p><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center" /><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center" /><p style="font-size:18pt; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; line-height:20.70001pt; text-align:center"><span style="font-weight:bold; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; line-height:20.70001pt; font-size:18pt; text-align:center">FACILITY ADDRESS </span></p><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center" /><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center" /><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center"><span style="text-align:center; line-height:20.70001pt; font-size:18pt"><span style="margin:2.965779pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; line-height:20.70001pt; font-size:18pt; text-align:center"><span style="font-weight:bold; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; line-height:20.70001pt; font-size:18pt; text-align:center">PROJECT OWNER NAME </span></span></span></p><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center" /><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center" /><p style="font-size:18pt; line-height:20.70001pt; color:#000000; margin:2.931949pt; margin-left:0pt; margin-right:0pt; margin-top:0pt; margin-bottom:0pt; text-align:center"><span style="text-align:center; line-height:20.70001pt; font-size:18pt"><span style="font-weight:bold; text-align:center; line-height:20.70001pt; font-size:18pt">PROJECT OWNER EMAIL </span></span></p></body>)/Contents<>>>
