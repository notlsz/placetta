{
  "name": "placetta-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run beam && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:single": "tsc -b && vite build --mode single",
    "postinstall": "node scripts/patch-bot-avatars.mjs",
    "launch": "node scripts/launch.mjs",
    "build:agent": "node scripts/build-agent.mjs",
    "guides": "npx tsx scripts/build-guides.mts",
    "beam": "esbuild src/site/beam.tsx --bundle --minify --format=iife --jsx=automatic --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=site/beam.js --log-level=warning",
    "test:agent": "esbuild scripts/agent-test.ts --bundle --platform=node --format=esm --outfile=.agent-test.mjs '--external:*.pdf?inline' --external:thinking-orbs --log-level=error && node .agent-test.mjs; rm -f .agent-test.mjs",
    "test:plan": "esbuild scripts/plan-test.ts --bundle --platform=node --format=esm --outfile=.plan-test.mjs '--external:*.pdf?inline' --log-level=error && node .plan-test.mjs; rm -f .plan-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.2.2",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "thinking-orbs": "^0.3.2",
    "voice-glow": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
